# ── App ───────────────────────────────────────────────────────────────────────
app_base_url: "/wms-app/"
app_root: "/var/www/html/wms-app"

# ── Git ───────────────────────────────────────────────────────────────────────
github_user: "YOUR_GITHUB_USERNAME"
github_repo: "YOUR_REPO_NAME"
github_token: "ghp_xxxx"          # GitHub Personal Access Token (repo scope)

# ── Database ──────────────────────────────────────────────────────────────────
db_root_pass: "CHANGE_ME_STRONG_PASSWORD"
db_name: "wms"
db_name2: "wms2"

# ── Node.js ───────────────────────────────────────────────────────────────────
node_port: 3000
node_emit_secret: "CHANGE_ME_LONG_RANDOM_STRING"
