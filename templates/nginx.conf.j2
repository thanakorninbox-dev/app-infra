# HTTP → HTTPS redirect
server {
    listen 80;
    server_name {{ client_domain }};
    return 301 https://$host$request_uri;
}

# HTTPS — self-signed cert (generated by deploy playbook)
server {
    listen 443 ssl;
    server_name {{ client_domain }};

    ssl_certificate     /etc/ssl/certs/{{ client_name }}.crt;
    ssl_certificate_key /etc/ssl/private/{{ client_name }}.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Serve uploaded files directly (Next.js doesn't follow symlinks in public/)
    location /wms-app/uploads/ {
        alias /var/www/html/{{ client_name }}/php/uploads/;
        expires 30d;
        add_header Cache-Control "public";
        client_max_body_size 2M;
    }

    location /wms-app/ {
        proxy_pass         http://127.0.0.1:{{ app_port }};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_cache_bypass $http_upgrade;
    }

    location /socket.io/ {
        proxy_pass         http://127.0.0.1:{{ scheduler_port }};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host $host;
    }
}
