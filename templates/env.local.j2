# Auto-generated by Ansible — do not edit manually
# Client: {{ client_name }}

# ── Next.js ───────────────────────────────────────────────────────────────────
PORT={{ app_port }}
NEXT_PUBLIC_APP_URL={{ next_public_app_url }}

# ── Auth DB (wms) ─────────────────────────────────────────────────────────────
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_USER={{ db_user }}
DB_PASS={{ db_password }}
DB_PASSWORD={{ db_password }}
DB_NAME={{ db_name }}

# ── Data DB (wms2) ────────────────────────────────────────────────────────────
DB2_HOST={{ db_host }}
DB2_PORT={{ db_port }}
DB2_USER={{ db_user }}
DB2_PASS={{ db_password }}
DB2_PASSWORD={{ db_password }}
DB2_NAME={{ db2_name }}

# ── Socket / Cron ─────────────────────────────────────────────────────────────
EMIT_SECRET={{ emit_secret }}
NEXT_APP_URL={{ next_public_app_url }}
NODE_PORT={{ scheduler_port }}

# ── System SMTP (fallback when no company_smtp configured) ───────────────────
SMTP_HOST={{ smtp_host | default('') }}
SMTP_PORT={{ smtp_port | default('587') }}
SMTP_USER={{ smtp_user | default('') }}
SMTP_PASS="{{ smtp_pass | default('') }}"
SMTP_FROM_NAME={{ smtp_from_name | default('WMS') }}
SMTP_FROM_EMAIL={{ smtp_from_email | default(smtp_user | default('')) }}
SMTP_ENCRYPTION={{ smtp_encryption | default('tls') }}

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_PASSWORD={{ session_password }}
SESSION_SECRET={{ session_password }}
